#!/usr/bin/env bash
set -euo pipefail

required_commands=(age ansible-playbook aws flux gitleaks kubectl pre-commit sops tailscale terraform)
missing_commands=()

for command in "${required_commands[@]}"; do
    if ! command -v "$command" >/dev/null; then
        missing_commands+=("$command")
    fi
done

if ((${#missing_commands[@]})); then
    printf 'Orb toolchain is incomplete; rerun .agents/setup (missing: %s)\n' "${missing_commands[*]}" >&2
    exit 1
fi

: "${AMP_THREAD_ID:?AMP_THREAD_ID is required in an Amp Orb}"
: "${TAILSCALE_CLIENT_ID:?Set TAILSCALE_CLIENT_ID in the Amp project environment}"
: "${TAILSCALE_AUDIENCE:?Set TAILSCALE_AUDIENCE in the Amp project environment}"

sudo systemctl start tailscaled

token_file="$(mktemp)"
trap 'rm -f "$token_file"' EXIT
chmod 600 "$token_file"
amp orb id-token --audience "$TAILSCALE_AUDIENCE" >"$token_file"

sudo tailscale up \
    --client-id="${TAILSCALE_CLIENT_ID}?ephemeral=true&preauthorized=true" \
    --id-token="file:$token_file" \
    --advertise-tags=tag:amp-orb \
    --hostname="amp-${AMP_THREAD_ID#T-}" \
    --timeout=20s

rm -f "$token_file"
trap - EXIT

tailscale configure kubeconfig tailscale-operator

printf 'Orb toolchain and Tailscale connection are ready.\n'
