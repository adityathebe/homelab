#!/usr/bin/env bash
set -euo pipefail

if ! command -v tailscale >/dev/null || [[ ! -x /usr/local/bin/kubectl.real ]]; then
    printf 'Tailscale or kubectl is missing; rerun .agents/setup.\n' >&2
    exit 1
fi

: "${TAILSCALE_CLIENT_ID:?Set TAILSCALE_CLIENT_ID in the Amp project environment}"
: "${TAILSCALE_AUDIENCE:?Set TAILSCALE_AUDIENCE in the Amp project environment}"

sudo systemctl start tailscaled

if tailscale ip -4 >/dev/null 2>&1 && \
    /usr/local/bin/kubectl.real config current-context >/dev/null 2>&1; then
    printf 'Tailscale Kubernetes access is ready.\n'
    exit 0
fi

token_file="$(mktemp)"
trap 'rm -f "$token_file"' EXIT
chmod 600 "$token_file"
if ! amp orb id-token --audience "$TAILSCALE_AUDIENCE" >"$token_file"; then
    printf 'Amp OIDC is not available yet; deferring Tailscale connection.\n' >&2
    exit 0
fi

thread_id="$(TOKEN_FILE="$token_file" python3 - <<'PY'
import base64
import json
import os

token = open(os.environ["TOKEN_FILE"], encoding="utf-8").read().strip()
payload = token.split(".")[1]
payload += "=" * (-len(payload) % 4)
print(json.loads(base64.urlsafe_b64decode(payload))["thread_id"])
PY
)"

sudo tailscale up \
    --client-id="${TAILSCALE_CLIENT_ID}?ephemeral=true&preauthorized=true" \
    --id-token="file:$token_file" \
    --advertise-tags=tag:amp-orb \
    --hostname="amp-${thread_id#T-}" \
    --timeout=20s

rm -f "$token_file"
trap - EXIT

tailscale configure kubeconfig tailscale-operator

printf 'Orb toolchain and Tailscale connection are ready.\n'
