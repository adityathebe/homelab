#!/usr/bin/env bash
set -euo pipefail

readonly KUBECTL_VERSION="1.34.10"
readonly TAILSCALE_VERSION="1.102.2"

started_at=$SECONDS
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

log() {
    printf '[orb setup +%ss] %s\n' "$((SECONDS - started_at))" "$*"
}

download() {
    local url=$1
    local checksum=$2
    local destination=$3

    curl --fail --location --silent --show-error \
        --retry 3 --retry-all-errors --connect-timeout 10 \
        "$url" --output "$destination"
    printf '%s  %s\n' "$checksum" "$destination" | sha256sum --check --status
}

install_kubectl() {
    if [[ -x /usr/local/bin/kubectl.real ]] && \
        /usr/local/bin/kubectl.real version --client 2>&1 | grep -Fq "Client Version: v${KUBECTL_VERSION}"; then
        return
    fi

    log "Installing kubectl ${KUBECTL_VERSION}"
    download \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        "95bd70842bd11a524d24acd5b68726899e3488e153e45e2b4ae846545beda050" \
        "$tmp_dir/kubectl"
    sudo install -m 0755 "$tmp_dir/kubectl" /usr/local/bin/kubectl.real
}

install_tailscale() {
    if command -v tailscale >/dev/null && tailscale version 2>&1 | sed -n '1p' | grep -Fxq "$TAILSCALE_VERSION"; then
        return
    fi

    log "Installing Tailscale ${TAILSCALE_VERSION}"
    sudo install -m 0755 -d /usr/share/keyrings /etc/apt/sources.list.d
    curl --fail --location --silent --show-error \
        --retry 3 --retry-all-errors --connect-timeout 10 \
        https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg \
        --output "$tmp_dir/tailscale-archive-keyring.gpg"
    curl --fail --location --silent --show-error \
        --retry 3 --retry-all-errors --connect-timeout 10 \
        https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list \
        --output "$tmp_dir/tailscale.list"
    sudo install -m 0644 "$tmp_dir/tailscale-archive-keyring.gpg" \
        /usr/share/keyrings/tailscale-archive-keyring.gpg
    sudo install -m 0644 "$tmp_dir/tailscale.list" /etc/apt/sources.list.d/tailscale.list
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "tailscale=${TAILSCALE_VERSION}"
}

configure_tailscale() {
    log "Configuring Tailscale for the Orb network"
    sudo install -m 0755 -d /etc/systemd/system/tailscaled.service.d
    sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable --now tailscaled
}

if [[ "$(uname -m)" != "x86_64" ]]; then
    printf 'Unsupported orb architecture: %s\n' "$(uname -m)" >&2
    exit 1
fi

cd "$(dirname "$0")/.."

install_kubectl
install_tailscale
configure_tailscale
sudo ln -sfn "$PWD/.agents/kubectl" /usr/local/bin/kubectl

log "Setup complete"
